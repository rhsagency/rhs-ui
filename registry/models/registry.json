    {
      "name": "model-viewer",
      "type": "registry:component",
      "title": "Model viewer",
      "description": "Demand-rendered 3D viewer with lazy loading, keyboard rotation and GLB export. No idle animation loop.",
      "categories": [
        "models"
      ],
      "meta": {
        "tier": "free",
        "version": "0.4.0",
        "since": "0.4.0",
        "status": "stable",
        "preview": "inline"
      },
      "dependencies": [
        "three@^0.186.0"
      ],
      "devDependencies": [
        "@types/three@^0.186.0"
      ],
      "registryDependencies": [],
      "files": [
        {
          "path": "registry/models/model-viewer.tsx",
          "type": "registry:component",
          "target": "components/rhs-ui/models/model-viewer.tsx"
        }
      ],
      "docs": "Pass this recipe to ModelViewer. Explore in 3D loads the renderer on demand; Download GLB exports the actual geometry and materials. No textures or external model requests."
    },
