      "css": {
        "@keyframes rhs-in": {
          "from": {
            "opacity": "0",
            "transform": "translateY(4px) scale(0.98)"
          },
          "to": {
            "opacity": "1",
            "transform": "translateY(0) scale(1)"
          }
        },
        "@keyframes rhs-out": {
          "from": {
            "opacity": "1",
            "transform": "translateY(0) scale(1)"
          },
          "to": {
            "opacity": "0",
            "transform": "translateY(4px) scale(0.98)"
          }
        },
        "@keyframes rhs-fade-in": {
          "from": {
            "opacity": "0"
          },
          "to": {
            "opacity": "1"
          }
        },
        "@keyframes rhs-fade-out": {
          "from": {
            "opacity": "1"
          },
          "to": {
            "opacity": "0"
          }
        },
        "@keyframes rhs-slide-in-right": {
          "from": {
            "transform": "translateX(100%)"
          },
          "to": {
            "transform": "translateX(0)"
          }
        },
        "@keyframes rhs-slide-out-right": {
          "from": {
            "transform": "translateX(0)"
          },
          "to": {
            "transform": "translateX(100%)"
          }
        },
        "@keyframes rhs-slide-in-left": {
          "from": {
            "transform": "translateX(-100%)"
          },
          "to": {
            "transform": "translateX(0)"
          }
        },
        "@keyframes rhs-slide-out-left": {
          "from": {
            "transform": "translateX(0)"
          },
          "to": {
            "transform": "translateX(-100%)"
          }
        },
        "@keyframes rhs-slide-in-top": {
          "from": {
            "transform": "translateY(-100%)"
          },
          "to": {
            "transform": "translateY(0)"
          }
        },
        "@keyframes rhs-slide-out-top": {
          "from": {
            "transform": "translateY(0)"
          },
          "to": {
            "transform": "translateY(-100%)"
          }
        },
        "@keyframes rhs-slide-in-bottom": {
          "from": {
            "transform": "translateY(100%)"
          },
          "to": {
            "transform": "translateY(0)"
          }
        },
        "@keyframes rhs-slide-out-bottom": {
          "from": {
            "transform": "translateY(0)"
          },
          "to": {
            "transform": "translateY(100%)"
          }
        }
      },
      "cssVars": {
        "theme": {
          "animate-rhs-in": "rhs-in 160ms cubic-bezier(0.2, 0.7, 0.2, 1)",
          "animate-rhs-out": "rhs-out 120ms cubic-bezier(0.4, 0, 1, 1)",
          "animate-rhs-fade-in": "rhs-fade-in 160ms ease-out",
          "animate-rhs-fade-out": "rhs-fade-out 120ms ease-in",
          "animate-rhs-slide-in-right": "rhs-slide-in-right 320ms cubic-bezier(0.2, 0.7, 0.2, 1)",
          "animate-rhs-slide-out-right": "rhs-slide-out-right 220ms cubic-bezier(0.4, 0, 1, 1)",
          "animate-rhs-slide-in-left": "rhs-slide-in-left 320ms cubic-bezier(0.2, 0.7, 0.2, 1)",
          "animate-rhs-slide-out-left": "rhs-slide-out-left 220ms cubic-bezier(0.4, 0, 1, 1)",
          "animate-rhs-slide-in-top": "rhs-slide-in-top 320ms cubic-bezier(0.2, 0.7, 0.2, 1)",
          "animate-rhs-slide-out-top": "rhs-slide-out-top 220ms cubic-bezier(0.4, 0, 1, 1)",
          "animate-rhs-slide-in-bottom": "rhs-slide-in-bottom 320ms cubic-bezier(0.2, 0.7, 0.2, 1)",
          "animate-rhs-slide-out-bottom": "rhs-slide-out-bottom 220ms cubic-bezier(0.4, 0, 1, 1)"
        }
      },
      "docs": "Wrap your app once in TooltipProvider. A tooltip is never the only place a label lives."
    },
