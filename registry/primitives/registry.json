      "name": "rhs-ui-theme",
      "type": "registry:theme",
      "title": "RHS UI theme",
      "description": "The RHS UI colour theme: a violet brand ramp on a constant OKLCH hue and a violet-tinted neutral scale, measured for WCAG AA in light and dark. Drops into any shadcn project as the semantic tokens.",
      "categories": [
        "primitives",
        "theme"
      ],
      "meta": {
        "tier": "free",
        "version": "0.2.0",
        "since": "0.1.0",
        "status": "stable",
        "preview": "inline"
      },
      "cssVars": {
        "theme": {
          "radius": "0.5rem"
        },
        "light": {
          "background": "oklch(0.992 0.003 290)",
          "foreground": "oklch(0.165 0.022 290)",
          "card": "oklch(1 0 0)",
          "card-foreground": "oklch(0.165 0.022 290)",
          "popover": "oklch(1 0 0)",
          "popover-foreground": "oklch(0.165 0.022 290)",
          "primary": "oklch(0.545 0.225 296)",
          "primary-foreground": "oklch(1 0 0)",
          "secondary": "oklch(0.955 0.004 290)",
          "secondary-foreground": "oklch(0.225 0.020 290)",
          "muted": "oklch(0.955 0.004 290)",
          "muted-foreground": "oklch(0.420 0.016 290)",
          "accent": "oklch(0.982 0.009 296)",
          "accent-foreground": "oklch(0.400 0.180 296)",
          "destructive": "oklch(0.580 0.210 25)",
          "destructive-foreground": "oklch(1 0 0)",
          "border": "oklch(0.905 0.006 290)",
