          "path": "registry/motion/scroll-progress.tsx",
          "type": "registry:component",
          "target": "components/rhs-ui/motion/scroll-progress.tsx"
        }
      ],
      "css": {
        "@keyframes rhs-progress": {
          "from": {
            "transform": "scaleX(0)"
          },
          "to": {
            "transform": "scaleX(1)"
          }
        }
      },
      "docs": "Sticky at the top of its container. Uses a CSS scroll timeline where available and a passive scroll listener elsewhere. Decorative, so hidden from assistive technology.",
