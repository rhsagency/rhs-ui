    {
      "name": "text-reveal",
      "type": "registry:component",
      "title": "Text Reveal",
      "description": "A statement that lights up word by word as it scrolls through the screen.",
      "categories": [
        "motion",
        "scroll"
      ],
      "meta": {
        "tier": "free",
        "version": "0.5.0",
        "since": "0.5.0",
        "status": "stable",
        "preview": "inline"
      },
      "dependencies": [],
      "registryDependencies": [],
      "files": [
        {
          "path": "registry/motion/text-reveal.tsx",
          "type": "registry:component",
          "target": "components/rhs-ui/motion/text-reveal.tsx"
        }
      ],
      "css": {
        "@keyframes rhs-text-word": {
          "from": {
            "opacity": "var(--text-reveal-dim)",
            "filter": "blur(3px)",
            "transform": "translateY(0.12em)"
          },
          "to": {
            "opacity": "1",
            "filter": "none",
            "transform": "none"
          }
        }
      },
      "docs": "For the one sentence a page is built around. Screen readers read the sentence whole. Give it room above and below, so the words have scroll to light up in. Clip a parent with overflow: clip, never overflow: hidden: a hidden overflow makes that parent the scroll container the timeline follows, and the animation stands still.",
      "cssVars": {
        "theme": {
          "animate-rhs-text-word": "rhs-text-word"
        }
      }
    },
