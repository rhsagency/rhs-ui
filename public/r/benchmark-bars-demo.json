{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "benchmark-bars-demo",
  "title": "Benchmark bars demo",
  "description": "A working preview of Benchmark bars.",
  "registryDependencies": [
    "https://rhsui.com/r/benchmark-bars.json"
