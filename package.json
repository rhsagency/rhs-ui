{
  "name": "rhs-ui",
  "version": "0.1.0",
  "description": "RHS UI: open-source components and blocks for React and Next.js, distributed as a shadcn-compatible registry.",
  "homepage": "https://rhsui.com",
  "repository": { "type": "git", "url": "https://github.com/rhsagency/rhs-ui.git" },
  "bugs": "https://github.com/rhsagency/rhs-ui/issues",
  "license": "MIT",
  "author": "RHS Agency (https://www.rhsagency.nl)",
  "type": "module",
  "private": false,
  "files": ["registry", "registry.json", "public/r", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "registry:build": "node scripts/build-registry.mjs",
    "check:registry": "node scripts/check-registry.mjs",
    "check:built": "node scripts/build-registry.mjs && git diff --exit-code --stat public/r",
    "check": "pnpm typecheck && pnpm check:registry",
    "test:install": "node scripts/test-install.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.15.0"
}
