{
  "name": "rhs-ui",
  "version": "0.2.0",
  "description": "RHS UI: open-source components and blocks for React and Next.js, distributed as a shadcn-compatible registry.",
  "homepage": "https://rhsui.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/rhsagency/rhs-ui.git"
  },
  "bugs": "https://github.com/rhsagency/rhs-ui/issues",
  "license": "MIT",
  "author": "RHS Agency (https://www.rhsagency.nl)",
  "type": "module",
  "private": false,
  "files": [
    "registry",
    "registry.json",
    "public/r",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "registry:build": "node scripts/build-registry.mjs",
    "check:registry": "node scripts/check-registry.mjs",
    "check:built": "node scripts/check-built.mjs",
    "check:contract": "node scripts/check-contract.mjs",
    "check": "pnpm typecheck && pnpm icons:check && pnpm check:registry && pnpm check:contract && pnpm test:index && pnpm test:button && pnpm test:render-prop && pnpm test:render && pnpm test:scroll-text",
    "icons:generate": "node scripts/icons/generate-animated.mjs",
    "icons:check": "node scripts/icons/generate-animated.mjs --check",
    "test:button": "node scripts/test-button.mjs",
    "test:render-prop": "node scripts/test-render-prop.mjs",
    "test:index": "node scripts/test-component-index.mjs",
    "test:render": "node scripts/test-render.mjs",
    "test:scroll-text": "node scripts/test-scroll-text.mjs",
    "test:install": "node scripts/test-install.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "esbuild": "0.25.12",
    "lenis": "1.3.27",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "three": "0.186.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.15.0"
}
